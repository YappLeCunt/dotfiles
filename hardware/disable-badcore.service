[Unit]
Description=Disable degraded CPU core 1 (CPUs 2,3)
After=multi-user.target

[Service]
Type=oneshot
# DMI guard: refuse to run on any machine but this laptop (see README)
ExecStartPre=/usr/local/sbin/guard-cpu-quarantine.sh
ExecStart=/bin/sh -c 'echo 0 > /sys/devices/system/cpu/cpu2/online || true; echo 0 > /sys/devices/system/cpu/cpu3/online || true'

[Install]
WantedBy=multi-user.target
